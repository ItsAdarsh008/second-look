# Anthropic — powers the cultural analysis (vision + structured findings)
ANTHROPIC_API_KEY=

# Magic Hour — generates alternative creative (https://magichour.ai/developer)
MAGIC_HOUR_API_KEY=

# Vercel Blob — stores uploaded creative. Leave empty in local dev to store uploads on disk under .data/
BLOB_READ_WRITE_TOKEN=

# Optional: Upstash Redis (Vercel Marketplace). Required in production so analyses, jobs,
# rate limits and the credit ceiling survive across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Global daily ceiling on Magic Hour credits across all users. Generation is refused past it.
MAX_DAILY_CREDITS=200

# Optional: Stripe — charge for reviews after the first free one (see DEPLOY.md §3).
# Leave STRIPE_SECRET_KEY empty for no paywall. Use a restricted key (rk_...) from a sandbox in development.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (/api/stripe/webhook), or the one `stripe listen` prints locally.
STRIPE_WEBHOOK_SECRET=
